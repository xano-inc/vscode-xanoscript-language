{
  "name": "xanoscript-language-server",
  "displayName": "XanoScript Language Server",
  "publisher": "xano",
  "icon": "resources/marketplace-icon.jpeg",
  "main": "./dist/extension.js",
  "description": "Language support for XanoScript (.xs files), the language that describes a Xano backend: syntax highlighting, diagnostics, completion, hover and snippets.",
  "version": "0.3.3",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/xano-inc/vscode-xanoscript-language"
  },
  "homepage": "https://github.com/xano-inc/vscode-xanoscript-language#readme",
  "bugs": {
    "url": "https://github.com/xano-inc/vscode-xanoscript-language/issues"
  },
  "license": "MIT",
  "keywords": [
    "xano",
    "xanoscript",
    "xs",
    "backend",
    "language server",
    "lsp"
  ],
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "xanoscript",
        "aliases": [
          "XanoScript",
          "xanoscript",
          "xs"
        ],
        "extensions": [
          ".xs"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./resources/xanoscript-icon.svg",
          "dark": "./resources/xanoscript-icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "xanoscript",
        "scopeName": "source.xanoscript",
        "path": "./syntaxes/xanoscript.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "xanoscript",
        "scopes": {
          "singleString": [
            "string.quoted.single.xanoscript"
          ],
          "doubleString": [
            "string.quoted.double.xanoscript"
          ],
          "tripleString": [
            "string.quoted.triple.xanoscript"
          ],
          "tripleMacro": [
            "macro"
          ]
        }
      }
    ],
    "snippets": [
      {
        "language": "xanoscript",
        "path": "./dist/xanoscript.json"
      }
    ]
  },
  "scripts": {
    "test": "npm run compile && node --test test/*.test.js",
    "lint": "eslint src --ext .ts",
    "snippets": "ts-node src/snippets/build.ts",
    "prepackage": "npm run snippets",
    "precompile": "npm run snippets",
    "compile": "npm run check-types && node esbuild.js",
    "check-types": "tsc --noEmit",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "vscode:prepublish": "npm run package",
    "package": "npm run check-types && node esbuild.js --production",
    "build-patch": "npm version patch && vsce package"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.10.6",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.6.0",
    "@xano/xanoscript-language-server": "12.20.0",
    "esbuild": "^0.25.1",
    "eslint": "^9.22.0",
    "globals": "^16.0.0",
    "npm-run-all": "^4.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.27.0",
    "vscode-languageclient": "^9.0.1"
  }
}
